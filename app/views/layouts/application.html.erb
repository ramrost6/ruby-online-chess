<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Checkmate" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <nav class="border-b border-zinc-800 bg-zinc-950/95">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
        <%= link_to root_path, class: "flex items-center gap-3 text-lg font-semibold tracking-tight" do %>
          <span class="flex h-9 w-9 items-center justify-center rounded bg-white text-xl text-zinc-950">♞</span>
          Checkmate
        <% end %>

        <div class="flex items-center gap-3 text-sm">
          <% if current_user %>
            <span class="hidden text-zinc-400 sm:inline">Welcome, <%= current_user.username %></span>
            <%= button_to "Logout", logout_path, method: :delete, class: "rounded border border-zinc-700 px-4 py-2 font-medium text-zinc-200 transition hover:border-zinc-500 hover:bg-zinc-800" %>
          <% else %>
            <%= link_to "Login", login_path, class: "rounded px-4 py-2 font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-white" %>
            <%= link_to "Sign Up", new_user_path, class: "rounded bg-white px-4 py-2 font-medium text-zinc-950 transition hover:bg-zinc-200" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% flash.each do |type, message| %>
      <div class="mx-auto max-w-7xl px-6 pt-6 lg:px-8">
        <div class="rounded border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm text-zinc-200"><%= message %></div>
      </div>
    <% end %>

    <main><%= yield %></main>
  </body>
</html>
