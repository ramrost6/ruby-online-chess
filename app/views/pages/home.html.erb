<section class="relative overflow-hidden bg-stone-900 text-white">
  <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(45deg, #fff 25%, transparent 25%, transparent 75%, #fff 75%), linear-gradient(45deg, #fff 25%, transparent 25%, transparent 75%, #fff 75%); background-position: 0 0, 3rem 3rem; background-size: 6rem 6rem;"></div>
  <div class="relative mx-auto grid max-w-7xl gap-16 px-6 py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8 lg:py-32">
    <div>
      <p class="mb-6 text-sm font-semibold uppercase tracking-[0.28em] text-stone-400">Play with purpose</p>
      <h1 class="max-w-3xl text-5xl font-semibold leading-tight tracking-tight sm:text-6xl">Your next great game starts here.</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-stone-300">A focused place for thoughtful chess. Create a lobby, invite a friend, and make every move count.</p>
      <div class="mt-10">
        <% if current_user %>
          <%= link_to "Create Lobby", "#", class: "inline-flex items-center rounded-md bg-white px-6 py-3 font-semibold text-stone-900 transition hover:bg-stone-200" %>
        <% else %>
          <%= link_to "Play Now", login_path, class: "inline-flex items-center rounded-md bg-white px-6 py-3 font-semibold text-stone-900 transition hover:bg-stone-200" %>
        <% end %>
      </div>
    </div>

    <div class="hidden justify-self-end sm:flex">
      <div class="grid grid-cols-4 border border-stone-600 bg-stone-800 p-3 shadow-2xl">
        <% %w[♜ ♞ ♝ ♛ ♟ ♟ ♟ ♟ ♙ ♙ ♙ ♙ ♗ ♕ ♘ ♖].each_with_index do |piece, index| %>
          <div class="grid h-16 w-16 place-items-center text-4xl <%= index / 4 % 2 == index % 2 ? 'bg-stone-300 text-stone-900' : 'bg-stone-700 text-stone-100' %> sm:h-20 sm:w-20"><%= piece %></div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
  <div class="grid gap-8 border-t border-stone-300 pt-8 sm:grid-cols-3">
    <div><p class="text-3xl font-semibold">01</p><p class="mt-2 text-sm text-stone-500">Create a private lobby</p></div>
    <div><p class="text-3xl font-semibold">02</p><p class="mt-2 text-sm text-stone-500">Invite your opponent</p></div>
    <div><p class="text-3xl font-semibold">03</p><p class="mt-2 text-sm text-stone-500">Play the position</p></div>
  </div>
</section>
