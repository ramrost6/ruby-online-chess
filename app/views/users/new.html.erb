<section class="flex min-h-[calc(100vh-73px)] items-center justify-center px-6 py-12">
  <div class="w-full max-w-md">
    <div class="mb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-stone-500">Join the board</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight">Create your account</h1>
      <p class="mt-2 text-stone-500">Start playing focused, competitive chess online.</p>
    </div>

    <div class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm">
      <% if @user.errors.any? %>
        <div class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= @user.errors.full_messages.to_sentence %></div>
      <% end %>

      <%= form_with model: @user, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :username, class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", class: "form-input w-full rounded-md border border-stone-300 bg-white px-3 py-2.5 text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-stone-900 focus:ring-1 focus:ring-stone-900" %>
        </div>
        <div>
          <%= form.label :email, class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.email_field :email, required: true, autocomplete: "email", class: "form-input w-full rounded-md border border-stone-300 bg-white px-3 py-2.5 text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-stone-900 focus:ring-1 focus:ring-stone-900" %>
        </div>
        <div>
          <%= form.label :password, class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", class: "form-input w-full rounded-md border border-stone-300 bg-white px-3 py-2.5 text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-stone-900 focus:ring-1 focus:ring-stone-900" %>
        </div>
        <div>
          <%= form.label :password_confirmation, class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-input w-full rounded-md border border-stone-300 bg-white px-3 py-2.5 text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-stone-900 focus:ring-1 focus:ring-stone-900" %>
        </div>
        <%= form.submit "Create account", class: "w-full rounded-md bg-stone-900 px-4 py-3 font-semibold text-white transition hover:bg-stone-700" %>
      <% end %>
    </div>

    <p class="mt-6 text-center text-sm text-stone-500">Already have an account? <%= link_to "Log in", login_path, class: "font-semibold text-stone-900 hover:underline" %></p>
  </div>
</section>
