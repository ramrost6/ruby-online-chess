<section
  class="min-h-[calc(100vh-5rem)] bg-stone-900 px-4 py-8 text-white sm:px-6 lg:px-8"
  data-game-id="<%= @game.id %>"
  data-player-color="<%= @player_color %>"
  data-move-url="<%= game_move_path(@game) %>"
  data-resign-url="<%= game_resign_path(@game) %>"
>
  <div class="mx-auto w-full max-w-xl">
    <div class="mb-5 flex items-center justify-between rounded-lg border border-stone-700 bg-stone-800 px-4 py-3 shadow-sm">
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-stone-400">Game</p>
        <p id="game-status" class="text-sm font-semibold text-white">Your color: <%= @player_color %></p>
      </div>
      <p id="game-turn" class="font-mono text-sm text-stone-300">White to move</p>
    </div>

    <div id="board" class="mx-auto min-h-[400px] w-full max-w-[400px]"></div>

    <div class="mt-5 flex items-center justify-between rounded-lg border border-stone-700 bg-stone-800 px-4 py-4 shadow-sm">
      <p id="last-move" class="text-sm text-stone-300">Make a legal move on the board.</p>
      <button id="resign-button" type="button" class="rounded-md border border-red-400/50 px-4 py-2 text-sm font-semibold text-red-300 transition hover:bg-red-950">Resign</button>
    </div>
  </div>
</section>

<link rel="stylesheet" href="/chessboardjs/css/chessboard-1.0.0.min.css">
<script src="/vendor/jquery-3.7.1.min.js"></script>
<script src="/chessboardjs/js/chessboard-1.0.0.min.js"></script>
<script>
  function showBoardError(boardElement, error) {
    console.error("Chessboard initialization failed:", error);
    boardElement.textContent = "The chessboard could not be loaded. Check the local board assets and restart the server.";
    boardElement.classList.add("grid", "place-items-center", "border", "border-red-400", "text-center", "text-sm", "text-red-300");
  }

  function initializeGameBoard() {
    const gameView = document.querySelector("[data-game-id]");
    const boardElement = document.querySelector("#board");
    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrfToken = csrfMeta ? csrfMeta.content : "";

    if (!gameView || !boardElement || !csrfToken) return false;
    if (boardElement.dataset.initialized === "true") return true;
    if (typeof window.jQuery !== "function" || typeof window.Chessboard !== "function") {
      showBoardError(boardElement, new Error("jQuery or chessboard.js is unavailable."));
      return true;
    }

    const playerColor = gameView.dataset.playerColor;
    let board;
    let version = -1;
    let currentFen = "start";

    function refreshLabels(state) {
    const status = document.querySelector("#game-status");
    const turn = document.querySelector("#game-turn");
    const resignButton = document.querySelector("#resign-button");
    const isCompleted = state.status === "completed";
    const winner = state.result === "white_won" ? "White" : state.result === "black_won" ? "Black" : "Draw";

    status.textContent = isCompleted ? `Game over: ${winner} won` : `Your color: ${playerColor}`;
    turn.textContent = isCompleted ? "Game finished" : `${state.turn === "white" ? "White" : "Black"} to move`;
    if (state.last_move) document.querySelector("#last-move").textContent = `Last move: ${state.last_move}`;
    resignButton.disabled = isCompleted;
    resignButton.classList.toggle("cursor-not-allowed", isCompleted);
    resignButton.classList.toggle("opacity-50", isCompleted);
  }

    function applyState(state) {
    if (state.version !== version || state.status === "completed") {
      version = state.version;
      currentFen = state.fen;
      board.position(state.fen);
      refreshLabels(state);
      boardElement.style.pointerEvents = state.status === "completed" ? "none" : "auto";
    }
    board.orientation(playerColor);
  }

    function sendMove(source, target, piece) {
    const isPawnPromotion = piece && piece.endsWith("P") && ["1", "8"].includes(target[1]);
    const promotion = isPawnPromotion ? "q" : null;

    fetch(gameView.dataset.moveUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken, Accept: "application/json" },
      body: JSON.stringify({ from: source, to: target, promotion: promotion })
    }).then(async (response) => {
      if (!response.ok) throw new Error("Move was rejected");
      await response.json();
    }).catch(() => {
      board.position(currentFen);
    });
    return "snapback";
  }

    async function resign() {
    if (!confirm("Resign this game?")) return;
    await fetch(gameView.dataset.resignUrl, {
      method: "POST",
      headers: { "X-CSRF-Token": csrfToken, Accept: "application/json" }
    });
  }

    try {
      board = window.Chessboard("board", {
        position: "start",
        orientation: playerColor,
        draggable: true,
        pieceTheme: "/chessboardjs/img/chesspieces/wikipedia/{piece}.png",
        onDrop: sendMove
      });
      boardElement.dataset.initialized = "true";
      window.__gameBoard = board;
      document.querySelector("#resign-button").addEventListener("click", resign);
      window.dispatchEvent(new CustomEvent("chessboard:ready"));
    } catch (error) {
      showBoardError(boardElement, error);
    }
    return true;
  }

  function startGameBoard(attempt = 0) {
    if (initializeGameBoard() || attempt >= 20) return;
    window.setTimeout(() => startGameBoard(attempt + 1), 50);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => startGameBoard(), { once: true });
  } else {
    startGameBoard();
  }
  document.addEventListener("turbo:load", () => startGameBoard());
</script>

<script type="module">
  function connectGameChannel() {
    const gameView = document.querySelector("[data-game-id]");
    if (!gameView) return;

    import("/vendor/actioncable.esm.js").then(({ createConsumer }) => {
      const consumer = createConsumer("/cable");
      consumer.subscriptions.create(
        { channel: "GameChannel", game_id: gameView.dataset.gameId },
        {
          received(state) {
            window.dispatchEvent(new CustomEvent("game:state", { detail: state }));
          }
        }
      );
    }).catch((error) => console.error("Action Cable connection failed:", error));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", connectGameChannel, { once: true });
  } else {
    connectGameChannel();
  }
</script>

<script>
  window.addEventListener("game:state", function(event) {
    const state = event.detail;
    window.__pendingGameState = state;
    const boardElement = document.querySelector("#board");
    const gameView = document.querySelector("[data-game-id]");
    if (!boardElement || !gameView || typeof window.Chessboard !== "function") return;
    if (!window.__gameBoard) return;

    if (window.__gameVersion !== state.version || state.status === "completed") {
      window.__gameVersion = state.version;
      window.__gameFen = state.fen;
      window.__gameBoard.position(state.fen);
      const status = document.querySelector("#game-status");
      const turn = document.querySelector("#game-turn");
      const resignButton = document.querySelector("#resign-button");
      const playerColor = gameView.dataset.playerColor;
      const isCompleted = state.status === "completed";
      const winner = state.result === "white_won" ? "White" : state.result === "black_won" ? "Black" : "Draw";

      status.textContent = isCompleted ? `Game over: ${winner} won` : `Your color: ${playerColor}`;
      turn.textContent = isCompleted ? "Game finished" : `${state.turn === "white" ? "White" : "Black"} to move`;
      if (state.last_move) document.querySelector("#last-move").textContent = `Last move: ${state.last_move}`;
      resignButton.disabled = isCompleted;
      boardElement.style.pointerEvents = isCompleted ? "none" : "auto";
    }
  });

  window.addEventListener("chessboard:ready", function() {
    if (window.__pendingGameState) {
      window.dispatchEvent(new CustomEvent("game:state", { detail: window.__pendingGameState }));
    }
  });
</script>
