<% variant = local_assigns.fetch(:variant, :secondary) %>
<% variant_classes = {
  primary: "bg-stone-900 text-white hover:bg-stone-700",
  secondary: "border border-stone-300 bg-white text-stone-700 hover:border-stone-500 hover:bg-stone-50",
  danger: "border border-red-200 bg-white text-red-700 hover:border-red-300 hover:bg-red-50"
}.fetch(variant) %>

<button type="<%= local_assigns.fetch(:type, "button") %>" class="inline-flex items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold transition <%= variant_classes %> <%= local_assigns.fetch(:class, "") %>">
  <%= label %>
</button>
